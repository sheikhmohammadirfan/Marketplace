# --- Server ---
PORT=5000
NODE_ENV=development
# Your deployed frontend origin (no trailing slash). Used for CORS + email links.
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# --- JWT ---
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Email (SMTP) ---
# If left unset, emails are printed to the server console instead of sent (fine for local dev).
# For production, use a real provider: SendGrid, Postmark, AWS SES, Mailgun, or Gmail SMTP w/ app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@yourapp.com

# --- Superadmin bootstrap (used only by scripts/createSuperAdmin.js, not by the API) ---
SUPERADMIN_EMAIL=admin@yourapp.com
SUPERADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_NAME=Super Admin

# --- AI assistant (floating chat helper, photo-to-ad draft, price suggestion) ---
# Works with ANY of these. Pick one, paste its key into AI_API_KEY. Empty key = AI features show a
# friendly "not set up" message; the rest of the app still works.
#
# OPTION A (default, FREE): Google Gemini. Get a key (no card needed) at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
AI_API_KEY=
# "-latest" aliases keep working when Google retires a model version. For smarter (but lower free quota)
# answers use gemini-flash-latest instead.
AI_MODEL=gemini-flash-lite-latest
# Optional: only for Groq/OpenAI-compatible providers (leave empty when using Gemini)
AI_BASE_URL=
# Optional: model used when a photo is attached (needed for Groq; leave empty otherwise)
AI_VISION_MODEL=
#
# OPTION B (FREE): Groq. Key at https://console.groq.com  -> use these four lines instead:
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# OPTION C (paid): OpenAI. Key at https://platform.openai.com -> use:
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
